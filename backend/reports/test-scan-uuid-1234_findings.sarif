{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "KAVACH",
          "version": "1.0.0",
          "informationUri": "https://kavach.security",
          "rules": [
            {
              "id": "hardcoded_secret",
              "name": "Hardcoded Secret",
              "shortDescription": {
                "text": "Hardcoded SQL Database Connection String"
              },
              "fullDescription": {
                "text": "A hardcoded username and password was found in the database connection string. This credentials can be easily extracted by decompiling the code or inspecting files in repositories."
              },
              "helpUri": "https://kavach.security/rules/hardcoded_secret",
              "properties": {
                "tags": [
                  "hardcoded_secret"
                ],
                "precision": "medium",
                "problem.severity": "critical"
              }
            },
            {
              "id": "sql_injection",
              "name": "Sql Injection",
              "shortDescription": {
                "text": "SQL Injection in User Login Handler"
              },
              "fullDescription": {
                "text": "User authentication executes queries constructed by string concatenation from user input, leading to SQL Injection."
              },
              "helpUri": "https://kavach.security/rules/sql_injection",
              "properties": {
                "tags": [
                  "sql_injection"
                ],
                "precision": "medium",
                "problem.severity": "high"
              }
            },
            {
              "id": "weak_cryptography",
              "name": "Weak Cryptography",
              "shortDescription": {
                "text": "Outdated Cryptographic Cipher Suite (3DES)"
              },
              "fullDescription": {
                "text": "The application relies on 3DES cryptographic library versions which are vulnerable to collision attacks (Sweet32)."
              },
              "helpUri": "https://kavach.security/rules/weak_cryptography",
              "properties": {
                "tags": [
                  "weak_cryptography"
                ],
                "precision": "medium",
                "problem.severity": "medium"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "hardcoded_secret",
          "level": "error",
          "message": {
            "text": "A hardcoded username and password was found in the database connection string. This credentials can be easily extracted by decompiling the code or inspecting files in repositories."
          },
          "properties": {
            "cvss": 9.8,
            "brs": 15.0,
            "source": "semgrep"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config/database.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 42
                }
              }
            }
          ]
        },
        {
          "ruleId": "sql_injection",
          "level": "error",
          "message": {
            "text": "User authentication executes queries constructed by string concatenation from user input, leading to SQL Injection."
          },
          "properties": {
            "cvss": 8.8,
            "brs": 12.0,
            "source": "semgrep"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/auth.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 88
                }
              }
            }
          ]
        },
        {
          "ruleId": "weak_cryptography",
          "level": "warning",
          "message": {
            "text": "The application relies on 3DES cryptographic library versions which are vulnerable to collision attacks (Sweet32)."
          },
          "properties": {
            "cvss": 5.9,
            "brs": 6.0,
            "source": "pip-audit"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "scan_id": "test-scan-uuid-1234",
        "repository": "test-banking-repo",
        "scanDate": "2026-06-23T04:25:20.358952+00:00"
      },
      "artifacts": [
        {
          "location": {
            "uri": "%SRCROOT%"
          },
          "description": {
            "text": "Source repository: test-banking-repo"
          }
        }
      ]
    }
  ]
}